# Normalize line endings across Windows, WSL2, and Linux
* text=auto eol=lf

*.go text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.svg text eol=lf

*.png binary
*.ico binary
*.woff2 binary
*.wasm binary
