# External Docker network shared with Traefik
TRAEFIK_NETWORK=traefik

# Traefik HTTPS entrypoint and certificate resolver names from your homelab stack
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

# Optional Traefik middleware to restrict access to internal LAN/VPN (e.g., lan-only@file).
# Leave empty during setup if Traefik handles internal access via router/entrypoint rules.
TRAEFIK_INTERNAL_MIDDLEWARE=
