# External Docker network shared with Traefik
TRAEFIK_NETWORK=traefik

# Traefik HTTPS entrypoint and certificate resolver names from your homelab stack
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

# Optional Traefik middleware to restrict access to internal LAN/VPN (e.g., lan-only@file).
# Leave empty during setup if Traefik handles internal access via router/entrypoint rules.
TRAEFIK_INTERNAL_MIDDLEWARE=

# Public hostname used by Traefik router rules (override in deploy/.env)
HEARTHSIDE_HOST=hearthside.example.com

# Hearthside Go API configuration
# For HTTPS deployment behind Traefik, set:
#   HEARTHSIDE_PUBLIC_BASE_URL=https://hearthside.example.com
#   HEARTHSIDE_COOKIE_SECURE=true
HEARTHSIDE_PUBLIC_BASE_URL=http://localhost:8080
HEARTHSIDE_COOKIE_SECURE=false
HEARTHSIDE_LOG_LEVEL=info
# Optional shared secret protecting first-run POST /api/v1/auth/bootstrap (leave empty if unneeded)
HEARTHSIDE_BOOTSTRAP_TOKEN=

# Optional generic OpenID Connect (OIDC) provider for adult household sign-in.
# OIDC is disabled unless BOTH HEARTHSIDE_OIDC_ISSUER_URL and HEARTHSIDE_OIDC_CLIENT_ID are set.
# Redirect URI to register at your IdP: ${HEARTHSIDE_PUBLIC_BASE_URL}/api/v1/auth/oidc/callback
#
# Example (Google):
#   HEARTHSIDE_OIDC_ISSUER_URL=https://accounts.google.com
#   HEARTHSIDE_OIDC_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
#   HEARTHSIDE_OIDC_CLIENT_SECRET=your-google-client-secret
#   HEARTHSIDE_OIDC_PROVIDER_NAME=Google
#
# Example (Self-hosted Authentik / Pocket ID / Authelia):
#   HEARTHSIDE_OIDC_ISSUER_URL=https://auth.example.com/application/o/hearthside/
#   HEARTHSIDE_OIDC_CLIENT_ID=your-client-id
#   HEARTHSIDE_OIDC_CLIENT_SECRET=your-client-secret
#   HEARTHSIDE_OIDC_PROVIDER_NAME=Family SSO
HEARTHSIDE_OIDC_ISSUER_URL=
HEARTHSIDE_OIDC_CLIENT_ID=
HEARTHSIDE_OIDC_CLIENT_SECRET=
HEARTHSIDE_OIDC_PROVIDER_NAME=
HEARTHSIDE_OIDC_SCOPES=openid profile email
