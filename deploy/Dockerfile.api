# syntax=docker/dockerfile:1

FROM golang:1.27.4-alpine AS builder
WORKDIR /src

COPY go.work ./
COPY engine/sudoku/ ./engine/sudoku/
COPY services/api/ ./services/api/

RUN mkdir -p /data && chown 65532:65532 /data
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/hearthside-api ./services/api/cmd/server

FROM gcr.io/distroless/static-debian12:nonroot

COPY --from=builder --chown=65532:65532 /data /data
COPY --from=builder /out/hearthside-api /usr/local/bin/hearthside-api

ENV HEARTHSIDE_ADDR=:8080 \
    HEARTHSIDE_DB_PATH=/data/hearthside.db \
    HEARTHSIDE_COOKIE_SECURE=true \
    HEARTHSIDE_LOG_LEVEL=info

USER nonroot:nonroot
VOLUME ["/data"]
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD ["/usr/local/bin/hearthside-api", "-healthcheck"]

ENTRYPOINT ["/usr/local/bin/hearthside-api"]
